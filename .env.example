# Root environment configuration template
# Copy to apps/api/.env and apps/web/.env.local as needed

# Fastify API (apps/api/.env)
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Next.js Web (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MUNICIPALITY_NAME="Riverdale Flood Control District"
NEXT_PUBLIC_DEMO_MODE=true
