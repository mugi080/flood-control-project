{
  "name": "flood-control-md",
  "version": "0.1.0",
  "private": true,
  "description": "Flood Control MD - Municipal Flood Monitoring and Alert System",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@flood-control/web",
    "dev:api": "npm run dev --workspace=@flood-control/api",
    "dev": "npm run dev:web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "keywords": [
    "flood-control",
    "emergency-management",
    "nextjs",
    "fastify",
    "leaflet",
    "material-ui"
  ],
  "author": "",
  "license": "ISC"
}
